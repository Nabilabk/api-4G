<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<VBox xmlns="http://javafx.com/javafx/17.0.2-ea" 
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.antennes.controller.LoginController"
      alignment="CENTER" spacing="20" 
      style="-fx-background-color: linear-gradient(135deg, #2c3e50 0%, #3498db 100%);">
    
    <VBox alignment="CENTER" spacing="15" 
          style="-fx-background-color: white; -fx-background-radius: 10; -fx-padding: 40; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.3), 10, 0, 0, 5);">
        
        <!-- Header -->
        <VBox alignment="CENTER" spacing="5">
            <Label text="🔐" style="-fx-font-size: 40px;"/>
            <Label text="NETWORK COVERAGE API" style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;"/>
            <Label text="Secure Authentication Required" style="-fx-text-fill: #7f8c8d; -fx-font-size: 12px;"/>
        </VBox>
        
        <!-- Login Form -->
        <VBox spacing="10" style="-fx-min-width: 300;">
            <Label text="Username:" style="-fx-text-fill: #2c3e50; -fx-font-weight: bold;"/>
            <TextField fx:id="usernameField" promptText="Enter username" 
                     style="-fx-background-radius: 5; -fx-border-color: #bdc3c7; -fx-border-radius: 5;"/>
            
            <Label text="Password:" style="-fx-text-fill: #2c3e50; -fx-font-weight: bold; -fx-padding: 10 0 0 0;"/>
            <PasswordField fx:id="passwordField" promptText="Enter password" 
                         style="-fx-background-radius: 5; -fx-border-color: #bdc3c7; -fx-border-radius: 5;"/>
            
            <Label fx:id="errorLabel" text="" 
                   style="-fx-text-fill: #e74c3c; -fx-font-size: 11px; -fx-padding: 5 0 0 0;"/>
            
            <Button fx:id="loginButton" text="LOGIN" onAction="#handleLogin" 
                    style="-fx-background-color: #3498db; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 5; -fx-padding: 10; -fx-font-size: 14px;"
                    defaultButton="true"/>
        </VBox>
        
        <!-- Footer with Role Information -->
        <VBox alignment="CENTER" spacing="5" style="-fx-padding: 20 0 0 0;">
            <Separator style="-fx-padding: 0 0 10 0;"/>
            <Label text="Available Test Accounts:" style="-fx-text-fill: #7f8c8d; -fx-font-size: 11px; -fx-font-weight: bold;"/>
            <GridPane hgap="10" vgap="5" style="-fx-padding: 5 0 0 0;">
                <Label text="👑 Admin:" style="-fx-text-fill: #e74c3c; -fx-font-weight: bold;"/>
                <Label text="admin / admin123" GridPane.columnIndex="1" 
                       style="-fx-text-fill: #95a5a6; -fx-font-size: 10px;"/>
                
                <Label text="🛠️ Operator:" GridPane.rowIndex="1" style="-fx-text-fill: #3498db; -fx-font-weight: bold;"/>
                <Label text="operator / operator123" GridPane.rowIndex="1" GridPane.columnIndex="1"
                       style="-fx-text-fill: #95a5a6; -fx-font-size: 10px;"/>
                
                <Label text="👁️ Viewer:" GridPane.rowIndex="2" style="-fx-text-fill: #2ecc71; -fx-font-weight: bold;"/>
                <Label text="viewer / viewer123" GridPane.rowIndex="2" GridPane.columnIndex="1"
                       style="-fx-text-fill: #95a5a6; -fx-font-size: 10px;"/>
            </GridPane>
            <Label text="Port: 4567 | JWT Authentication | Role-Based Access" 
                   style="-fx-text-fill: #95a5a6; -fx-font-size: 9px; -fx-font-style: italic; -fx-padding: 5 0 0 0;"/>
        </VBox>
    </VBox>
</VBox>