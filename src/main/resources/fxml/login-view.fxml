<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.effect.DropShadow?>

<VBox xmlns="http://javafx.com/javafx/17.0.2-ea" 
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.antennes.controller.LoginController"
      alignment="CENTER" spacing="20" 
      style="-fx-background-color: linear-gradient(135deg, #2c3e50 0%, #3498db 100%);"
      prefWidth="400" prefHeight="450">
    
    <VBox alignment="CENTER" spacing="15" 
          style="-fx-background-color: white; -fx-background-radius: 10; -fx-padding: 30;">
        <effect>
            <DropShadow radius="10" offsetX="0" offsetY="5" color="rgba(0,0,0,0.3)"/>
        </effect>
        
        <!-- Header -->
        <VBox alignment="CENTER" spacing="5">
            <Label text="🔐" style="-fx-font-size: 40px;"/>
            <Label text="NETWORK COVERAGE API" style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;"/>
            <Label text="Secure Authentication Required" style="-fx-text-fill: #7f8c8d; -fx-font-size: 12px;"/>
        </VBox>
        
        <!-- Login Form -->
        <VBox spacing="10" style="-fx-min-width: 250;">
            <Label text="Username:" style="-fx-text-fill: #2c3e50; -fx-font-weight: bold;"/>
            <TextField fx:id="usernameField" promptText="Enter username" 
                     style="-fx-background-radius: 5; -fx-border-color: #bdc3c7; -fx-border-radius: 5; -fx-padding: 8;"/>
            
            <Label text="Password:" style="-fx-text-fill: #2c3e50; -fx-font-weight: bold;"/>
            <PasswordField fx:id="passwordField" promptText="Enter password" 
                         style="-fx-background-radius: 5; -fx-border-color: #bdc3c7; -fx-border-radius: 5; -fx-padding: 8;"/>
            
            <Label fx:id="errorLabel" text="" 
                   style="-fx-text-fill: #e74c3c; -fx-font-size: 11px; -fx-padding: 5 0 0 0;"/>
          
        </VBox>

        <VBox alignment="CENTER" spacing="10" style="-fx-padding: 20 0 0 0;">
            <Button fx:id="loginButton" text="LOG IN" onAction="#handleLogin" 
                    style="-fx-background-color: #3498db; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 5; -fx-padding: 10; -fx-font-size: 14px;"
                    defaultButton="true"/>
        </VBox>

        
        <!-- Simple Footer -->
        <VBox alignment="CENTER" spacing="5" style="-fx-padding: 20 0 0 0;">
            <Separator/>
            <Label text="JWT Authentication | Role-Based Access" 
                   style="-fx-text-fill: #95a5a6; -fx-font-size: 9px; -fx-font-style: italic; -fx-padding: 5 0 0 0;"/>
        </VBox>
    </VBox>
</VBox>
